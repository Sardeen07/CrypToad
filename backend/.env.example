# Copy to backend/.env (git-ignored) and fill in. docker compose and uvicorn both read it.
# Plaid Sandbox keys: https://dashboard.plaid.com/developers/keys
CRYPTOAD_PLAID_CLIENT_ID=
CRYPTOAD_PLAID_SECRET=
CRYPTOAD_PLAID_ENV=sandbox
# Any long random string; encrypts bank access tokens at rest.
CRYPTOAD_SECRET_KEY=
